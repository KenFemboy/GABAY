DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gabay
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document storage: "local" (default, writes to STORAGE_LOCAL_DIR) or "supabase".
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
# Supabase Storage (backend only; never put the service-role key in the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gabay-documents
MAX_UPLOAD_MB=15
SIGNED_URL_TTL_SECONDS=60
# Base URL of this API as seen by the browser (used for local-storage signed URLs).
PUBLIC_API_URL=http://localhost:8000
