DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gabay
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document storage: "local" (default, writes to STORAGE_LOCAL_DIR) or "supabase".
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
# Supabase Storage (backend only; never put the service-role key in the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gabay-documents
MAX_UPLOAD_MB=15
SIGNED_URL_TTL_SECONDS=60
# Base URL of this API as seen by the browser (used for local-storage signed URLs).
PUBLIC_API_URL=http://localhost:8000

# OCR (Stage 5). Start the worker with: python -m app.workers.ocr_worker
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave blank to use tesseract from PATH (Docker image / Linux).
TESSERACT_CMD=
OCR_LANGUAGES=eng+fil
OCR_DPI=300
OCR_MAX_PAGES=50
OCR_REVIEW_CONFIDENCE=70
OCR_MIN_TEXT_LAYER_CHARS=20
OCR_PAGE_TIMEOUT_SECONDS=120
OCR_WORKER_POLL_SECONDS=2
OCR_JOB_TIMEOUT_MINUTES=30
OCR_MAX_ATTEMPTS=2

# Information extraction (Stage 6). Rule-based only for now; AI extraction is not built yet.
EXTRACTION_AI_ENABLED=false
